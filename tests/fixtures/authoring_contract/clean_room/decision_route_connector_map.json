    {
      "authored_path": "/intent/process_ir/body/steps/2",
      "contract_entry_ids": [
        "node.decision",
        "placement.decision_true_arm.terminal",
        "placement.decision_false_arm.terminal"
      ],
      "decision_id": "the_two_arms_admit_different_bodies",
      "why": "A routed target is legal on the TRUE arm and not on the FALSE arm."
    },
    {
      "authored_path": "/intent/process_ir/body/steps/2/false_arm",
      "contract_entry_ids": [
        "placement.decision_false_arm.step",
        "node.stop"
      ],
      "decision_id": "the_false_arm_may_stop_with_no_steps",
      "why": "The one body that may be empty; a Branch path and the true arm may not."
    },
    {
      "authored_path": "/intent/process_ir/body/steps/2/true_arm/terminal",
      "contract_entry_ids": [
        "node.target",
        "connector_action.rest.patch"
      ],
      "decision_id": "the_rest_target_returns_documents",
      "why": "A REST PATCH returns documents; a database Send would not \u2014 the action decides."
    },
    {
      "authored_path": "/intent/process_ir/body/steps/2/true_arm/terminal",
      "contract_entry_ids": [
        "semantic_rule.control.no_continuation"
      ],
      "decision_id": "each_arm_terminates_independently",
      "why": "No continuation and no join after a Decision."
    }
