oolean"},"kind":{"const":"process_call","title":"Kind","type":"string"},"label":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Label"},"process_ref":{"description":"Opaque component reference: exact '$ref:KEY' token or literal component id","title":"Process Ref","type":"string"},"wait":{"default":true,"title":"Wait","type":"boolean"}},"required":["kind","process_ref"],"title":"ProcessCallNodeV1","type":"object"},"ProfilePropertySourceV1":{"additionalProperties":false,"properties":{"element_id":{"minLength":1,"title":"Element Id","type":"string"},"element_name":{"minLength":1,"title":"Element Name","type":"string"},"profile_ref":{"description":"Opaque component reference: exact '$ref:KEY' token or literal component id","title":"Profile Ref","type":"string"},"profile_type":{"description":"e.g. profile.json","minLength":1,"title":"Profile Type","type":"string"},"value_type":{"const":"profile","title":"Value Type","type":"string"}},"required":["value_type","element_id","element_name","profile_ref","profile_type"],"title":"ProfilePropertySourceV1","type":"object"},"RetryPolicyV1":{"additionalProperties":false,"description":"Bounded retry intent for a protected region.\n\n``count`` is the whole policy. The platform owns everything else: the wait\nbefore each attempt is fixed and not authorable, and retries are skipped\nentirely in test runs. Authoring a delay, a backoff curve, or a per-attempt\npolicy is therefore not a feature this version withholds \u2014 there is no field\non the wire to carry it.","properties":{"count":{"description":"Retry attempts for a failed document (0-5); 0 means no retry","maximum":5,"minimum":0,"title":"Count","type":"integer"}},"required":["count"],"title":"RetryPolicyV1","type":"object"},"ReturnDocumentsNodeV1":{"additionalProperties":false,"properties":{"kind":{"const":"return_documents","title":"Kind","type":"string"},"label":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Label"}},"required":["kind"],"title":"ReturnDocumentsNodeV1","type":"object"},"SequenceNodeV1":{"additionalProperties":false,"description":"Ordered root sequence. Local structural rules mirror today's builder:\n\n- a connector flow starts with ``source`` and ends in exactly one of\n  ``target``+``stop``, a standalone ``return_documents`` terminal (the\n  legacy Return Documents path never emits the target), or a terminal\n  control (``branch``/``decision``/``exception``);\n- a process-call flow contains only ``process_call`` steps plus a\n  ``stop``/``return_documents`` terminal (mixed connector execution is\n  capability-gated);\n- a CONTROL-ONLY root (#141) is exactly one ``branch``/``decision`` and\n  nothing else;\n- ``cache_put`` must be immediately followed by a stream-replacing cache\n  read (never by the target/terminal).","properties":{"kind":{"const":"sequence","title":"Kind","type":"string"},"steps":{"items":{"discriminator":{"mapping":{"branch":"#/$defs/BranchNodeV1","cache_get":"#/$defs/CacheGetNodeV1","cache_put":"#/$defs/CachePutNodeV1","cache_remove":"#/$defs/CacheRemoveNodeV1","connector_call":"#/$defs/ConnectorCallNodeV1","data_process":"#/$defs/DataProcessNodeV1","decision":"#/$defs/DecisionNodeV1","document_cache_retrieve":"#/$defs/DocumentCacheRetrieveNodeV1","exception":"#/$defs/ExceptionNodeV1","flow_control":"#/$defs/FlowControlNodeV1","map_ref":"#/$defs/MapRefNodeV1","message":"#/$defs/MessageNodeV1","process_call":"#/$defs/ProcessCallNodeV1","return_documents":"#/$defs/ReturnDocumentsNodeV1","set_ddp":"#/$defs/SetDdpNodeV1","set_dpp":"#/$defs/SetDppNodeV1","source":"#/$defs/SourceEndpointV1","stop":"#/$defs/StopNodeV1","target":"#/$defs/TargetEndpointV1","try_catch":"#/$defs/TryCatchNodeV1"},"propertyName":"kind"},"oneOf":[{"$ref":"#/$defs/SourceEndpointV1"},{"$ref":"#/$defs/TargetEndpointV1"},{"$ref":"#/$defs/ConnectorCallNodeV1"},{"$ref":"#/$defs/FlowControlNodeV1"},{"$ref":"#/$defs/MessageNodeV1"},{"$ref":"#/$defs/MapRefNodeV1"},{"$ref":"#/$defs/DataProcessNode