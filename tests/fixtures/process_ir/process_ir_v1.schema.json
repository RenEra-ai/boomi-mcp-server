plicate-authority split ADR-001 exists to remove.\n\n``action`` is an OPTIONAL ASSERTION of caller intent. It never supplies\nemitter metadata: the family and action that reach the wire always come from\nthe resolved operation symbol. A supplied value that disagrees with the\nauthoritative one is an error, never an override.","properties":{"action":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Action"},"idempotency":{"anyOf":[{"discriminator":{"mapping":{"key_reference":"#/$defs/KeyReferenceIdempotencyV1","verified_action":"#/$defs/VerifiedActionIdempotencyV1"},"propertyName":"kind"},"oneOf":[{"$ref":"#/$defs/VerifiedActionIdempotencyV1"},{"$ref":"#/$defs/KeyReferenceIdempotencyV1"}]},{"type":"null"}],"default":null,"title":"Idempotency"},"kind":{"const":"connector_call","title":"Kind","type":"string"},"label":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Label"},"operation_ref":{"description":"Opaque component reference: exact '$ref:KEY' token or literal component id","title":"Operation Ref","type":"string"}},"required":["kind","operation_ref"],"title":"ConnectorCallNodeV1","type":"object"},"CurrentPropertySourceV1":{"additionalProperties":false,"properties":{"value_type":{"const":"current","title":"Value Type","type":"string"}},"required":["value_type"],"title":"CurrentPropertySourceV1","type":"object"},"CustomScriptingOpV1":{"additionalProperties":false,"properties":{"language":{"const":"groovy2","default":"groovy2","title":"Language","type":"string"},"operation":{"const":"custom_scripting","title":"Operation","type":"string"},"script":{"minLength":1,"title":"Script","type":"string"},"use_cache":{"const":true,"default":true,"title":"Use Cache","type":"boolean"}},"required":["operation","script"],"title":"CustomScriptingOpV1","type":"object"},"DataProcessNodeV1":{"additionalProperties":false,"properties":{"kind":{"const":"data_process","title":"Kind","type":"string"},"label":{"anyOf":[{"type":"string"},{"type":"null"}]