{
  "body": {
    "kind": "sequence",
    "steps": [
      {
        "catch_body": {
          "steps": [
            {
              "kind": "message",
              "text": "failed"
            }
          ],
          "terminal": {
            "kind": "exception",
            "message_template": "caught {1}"
          }
        },
        "kind": "try_catch",
        "retry": {
          "count": 0
        },
        "scope": "process",
        "try_body": {
          "steps": [
            {
              "kind": "connector_call",
              "operation_ref": "$ref:GETOP"
            }
          ],
          "terminal": {
            "kind": "stop"
          }
        }
      }
    ]
  },
  "version": "1"
}
