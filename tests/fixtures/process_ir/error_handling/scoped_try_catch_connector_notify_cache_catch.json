{
  "body": {
    "kind": "sequence",
    "steps": [
      {
        "kind": "connector_call",
        "operation_ref": "$ref:GETOP"
      },
      {
        "catch_body": {
          "steps": [
            {
              "kind": "notify",
              "level": "ERROR",
              "message_template": "Integration catch path failed. Caught error: meta.base.catcherrorsmessage"
            }
          ],
          "terminal": {
            "cache_ref": "$ref:CACHE",
            "kind": "cache_put"
          }
        },
        "kind": "try_catch",
        "retry": {
          "count": 0
        },
        "scope": "connector",
        "try_body": {
          "steps": [
            {
              "kind": "connector_call",
              "operation_ref": "$ref:GETOP2"
            }
          ],
          "terminal": {
            "kind": "stop"
          }
        }
      }
    ]
  },
  "version": "1"
}
