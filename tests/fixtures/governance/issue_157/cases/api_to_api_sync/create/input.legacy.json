{
  "baseline_sha": "ba1be9f34317d720d3b012484622ab7e2742143b",
  "entry": {
    "example": "minimal_rest_to_rest_sync",
    "kind": "archetype_example"
  },
  "input": {
    "archetype": "api_to_api_sync",
    "parameters": {
      "naming": {
        "component_prefix": "DEMO",
        "integration_name": "demo-api-to-api-sync"
      },
      "source": {
        "binding": {
          "mode": "create",
          "settings": {
            "auth_mode": "none",
            "base_url": "https://source.example.com"
          }
        },
        "fetch_request": {
          "path": "/v1/<<source resource>>"
        },
        "response_profile": {
          "format": "json",
          "root": {
            "children": [
              {
                "data_type": "character",
                "kind": "simple",
                "name": "source_a"
              }
            ],
            "kind": "object",
            "name": "Root"
          }
        }
      },
      "target": {
        "binding": {
          "mode": "create",
          "settings": {
            "auth_mode": "none",
            "base_url": "https://target.example.com"
          }
        },
        "payload_profile": {
          "format": "json",
          "root": {
            "children": [
              {
                "data_type": "character",
                "kind": "simple",
                "name": "target_a"
              }
            ],
            "kind": "object",
            "name": "Root"
          }
        },
        "send_request": {
          "method": "POST",
          "path": "/v1/<<target resource>>"
        }
      },
      "transform": {
        "operations": [
          {
            "operation_type": "direct",
            "source_path": "Root/source_a",
            "target_path": "Root/target_a"
          }
        ]
      }
    }
  }
}
