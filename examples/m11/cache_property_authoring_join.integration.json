{
  "example_not_template": true,
  "is_template": false,
  "template_status": "example_only_not_reusable_template",
  "purpose": "M11 (#125): cross-branch handoff via a typed Document Cache \u2014 branch leg 1 stages documents with cache_put, leg 2 consumes them with cache_get (sequential leg order satisfies the #123 lineage contract), and a map declares a DocumentCacheJoins entry against the same cache (live-captured #119 wire shape).",
  "do_not_reuse": "Concrete values below are demo-grade so the spec plans clean in tests; model real cache indexes/keys on your actual profile elements.",
  "integration_spec": {
    "naming": {
      "integration_name": "M11 Cache Join Demo"
    },
    "components": [
      {
        "key": "cache_profile",
        "type": "profile.json",
        "action": "create",
        "name": "M11 Demo Cache Profile",
        "config": {
          "component_type": "profile.json",
          "profile_type": "json.generated",
          "component_name": "M11 Demo Cache Profile",
          "root": {
            "name": "Root",
            "kind": "object",
            "children": [
              {
                "name": "id",
                "kind": "simple",
                "data_type": "character"
              },
              {
                "name": "payload",
                "kind": "simple",
                "data_type": "character"
              }
            ]
          }
        }
      },
      {
        "key": "handoff_cache",
        "type": "documentcache",
        "action": "create",
        "name": "M11 Handoff Cache",
        "depends_on": [
          "cache_profile"
        ],
        "config": {
          "component_type": "documentcache",
          "component_name": "M11 Handoff Cache",
          "profile_type": "profile.json",
          "profile_id": "$ref:cache_profile",
          "indexes": [
            {
              "index_id": 1,
              "index_name": "by id",
              "keys": [
                {
                  "id": 2,
                  "element_key": "2",
                  "name": "id (Root/id)"
                }
              ]
            }
          ]
        }
      },
      {
        "key": "join_map",
        "type": "transform.map",
        "action": "create",
        "name": "M11 Cache Join Map",
        "depends_on": [
          "cache_profile",
          "handoff_cache"
        ],
        "config": {
          "component_type": "transform.map",
          "map_type": "direct",
          "component_name": "M11 Cache Join Map",
          "source_profile_id": "$ref:cache_profile",
          "source_profile_type": "profile.json",
          "target_profile_id": "$ref:cache_profile",
          "target_profile_type": "profile.json",
          "field_mappings": [
            {
              "source_path": "Root/id",
              "target_path": "Root/id"
            }
          ],
          "document_cache_joins": [
            {
              "document_cache_id": "$ref:handoff_cache",
              "cache_index": 1,
              "join_id": 8,
              "src_parent_key": "1",
              "key_values": [
                {
                  "cache_key_id": 2,
                  "cache_key_name": "id (Root/id)",
                  "src_link_key": "2"
                }
              ]
            }
          ]
        }
      },
      {
        "key": "join_db_connection",
        "type": "connector-settings",
        "action": "create",
        "name": "M11 Join DB Connection",
        "config": {
          "connector_type": "database",
          "component_name": "M11 Join DB Connection",
          "driver_id": "microsoft_jdbc",
          "auth_mode": "username_password",
          "username": "<<db user>>",
          "credential_ref": "<<opaque credential reference>>",
          "host": "db.example.invalid",
          "port": 1433,
          "dbname": "AppDB"
        },
        "depends_on": [],
        "component_id": null
      },
      {
        "key": "join_db_read_profile",
        "type": "profile.db",
        "action": "create",
        "name": "M11 Join DB Read Profile",
        "config": {
          "profile_type": "database.read",
          "component_name": "M11 Join DB Read Profile",
          "query": "<<user-authored DB read statement>>",
          "output_fields": [
            {
              "name": "id",
              "data_type": "character",
              "mandatory": false,
              "enforce_unique": false
            },
            {
              "name": "payload",
              "data_type": "character",
              "mandatory": false,
              "enforce_unique": false
            }
          ]
        },
        "depends_on": [],
        "component_id": null
      },
      {
        "key": "join_db_get_operation",
        "type": "connector-action",
        "action": "create",
        "name": "M11 Join DB Get",
        "config": {
          "connector_type": "database",
          "operation_mode": "get",
          "component_name": "M11 Join DB Get",
          "read_profile_id": "$ref:join_db_read_profile",
          "connection_ref_key": "join_db_connection"
        },
        "depends_on": [
          "join_db_connection",
          "join_db_read_profile"
        ],
        "component_id": null
      },
      {
        "key": "join_rest_connection",
        "type": "connector-settings",
        "action": "create",
        "name": "M11 Join REST Connection",
        "config": {
          "connector_type": "rest",
          "component_name": "M11 Join REST Connection",
          "base_url": "https://orders.example.invalid",
          "auth": "NONE"
        },
        "depends_on": [],
        "component_id": null
      },
      {
        "key": "join_rest_operation",
        "type": "connector-action",
        "action": "create",
        "name": "M11 Join REST Send",
        "config": {
          "connector_type": "rest",
          "operation_mode": "execute",
          "component_name": "M11 Join REST Send",
          "connection_ref_key": "join_rest_connection",
          "method": "POST",
          "path": "/v1/orders",
          "request_profile_id": "$ref:cache_profile",
          "request_profile_type": "json"
        },
        "depends_on": [
          "join_rest_connection",
          "cache_profile"
        ],
        "component_id": null
      }
    ],
    "processes": [
      {
        "envelope": {
          "component_key": "handoff_process",
          "name": "M11 Cross Branch Handoff Flow",
          "action": "create",
          "depends_on": [
            "handoff_cache",
            "join_db_connection",
            "join_db_get_operation",
            "join_rest_connection",
            "join_rest_operation"
          ]
        },
        "process_ir": {
          "version": "1",
          "body": {
            "kind": "sequence",
            "steps": [
              {
                "kind": "source",
                "connection_ref": "$ref:join_db_connection",
                "operation_ref": "$ref:join_db_get_operation"
              },
              {
                "kind": "branch",
                "legs": [
                  {
                    "steps": [],
                    "terminal": {
                      "kind": "cache_put",
                      "cache_ref": "$ref:handoff_cache",
                      "label": "Stage rows"
                    }
                  },
                  {
                    "steps": [
                      {
                        "kind": "cache_get",
                        "cache_ref": "$ref:handoff_cache",
                        "empty_cache_behavior": "stopprocess",
                        "external_writer": false,
                        "label": "Consume staged rows"
                      }
                    ],
                    "terminal": {
                      "kind": "target",
                      "connection_ref": "$ref:join_rest_connection",
                      "operation_ref": "$ref:join_rest_operation"
                    }
                  }
                ],
                "label": "Stage then consume"
              }
            ]
          }
        }
      }
    ]
  }
}
